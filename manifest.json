{
  "package": "Stitch Studio Atelier enhanced v0.4 beta",
  "release_date": "2026-11-11 (US Eastern)",
  "source": "user-provided Stitch Studio v0.3 + integration scaffold",
  "scope": "Opt-in adaptive knit-texture and construction-preview implementation; no changes to underlying knitting calculations",
  "implemented": [
    "adapter and invalid-state clearing",
    "physical-cm illustrative geometry for all eight templates",
    "multiscale canvas yarn shading",
    "stitch inspector with keyboard/touch",
    "source-piece layers",
    "stage-level construction time-lapse",
    "illustrative PNG export",
    "responsive interface"
  ],
  "not_implemented": [
    "verified complete knitting chart operations",
    "true low-poly 3D garment + UV mapping",
    "physical yarn drape",
    "PDF/print chart pagination",
    "body scan and fit guarantees"
  ],
